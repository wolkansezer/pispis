rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(h) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(h)).data.members;
    }

    // Aile (hane): 6 karakterlik kod belge kimliğidir.
    match /households/{h} {
      // Yeni aile: sadece kurucu üye olarak yazılabilir.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];
      // Üyeler okur.
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Koda katılma: sadece kendini üyelere ekleyebilirsin, başka hiçbir alan değişmez.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members;

      // Kayıtlar, stok, randevular, sesler, ayarlar: sadece aile üyeleri.
      match /{rest=**} {
        allow read, write: if isMember(h);
      }
    }

    // Destek talepleri: herkes sadece kendi talebini okur ve yazar.
    // Sen hepsini Firebase konsolunda Firestore › support altında görürsün.
    match /support/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
